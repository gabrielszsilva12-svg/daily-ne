rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }

    match /tasks/{id}      { allow read, write: if logado(); }
    match /lembretes/{id}  { allow read, write: if logado(); }
    match /ideias/{id}     { allow read, write: if logado(); }
    match /dailies/{id}    { allow read, write: if logado(); }
    match /semanas/{id}    { allow read, write: if logado(); }
    match /config/{id}     { allow read, write: if logado(); }
    match /meta/{id}       { allow read, write: if logado(); }

    // Histórico: cada navegador só grava no próprio registro.
    match /historico/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;
    }
  }
}
